{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rodaq:plugin:com.rodaq.acquisition.ros2:config:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "streams"
  ],
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "domain_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 232,
      "default": 0
    },
    "executor_threads": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "default": 2
    },
    "graph_poll_interval": {
      "allOf": [
        {
          "$ref": "#/$defs/duration"
        },
        {
          "not": {
            "properties": {
              "value": {
                "const": "0"
              }
            }
          }
        }
      ]
    },
    "qos_change_debounce": {
      "$ref": "#/$defs/duration"
    },
    "streams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stream_key",
          "topic",
          "qos"
        ],
        "properties": {
          "stream_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[!-~]+(?![\\s\\S])"
          },
          "topic": {
            "type": "string",
            "minLength": 2,
            "maxLength": 247,
            "pattern": "^/[A-Za-z_][A-Za-z0-9_]*(/[A-Za-z_][A-Za-z0-9_]*)*(?![\\s\\S])"
          },
          "type": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}/(msg|srv|action)/([A-Za-z][A-Za-z0-9_]{0,127}/)*[A-Za-z][A-Za-z0-9_]{0,127}(?![\\s\\S])"
          },
          "qos": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "const": "adapt"
                  },
                  "depth": {
                    "type": "string",
                    "pattern": "^([1-9][0-9]{0,5}|1000000)(?![\\s\\S])",
                    "default": "10"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mode",
                  "depth",
                  "reliability",
                  "durability"
                ],
                "properties": {
                  "mode": {
                    "const": "explicit"
                  },
                  "depth": {
                    "type": "string",
                    "pattern": "^([1-9][0-9]{0,5}|1000000)(?![\\s\\S])",
                    "default": "10"
                  },
                  "reliability": {
                    "enum": [
                      "reliable",
                      "best_effort"
                    ]
                  },
                  "durability": {
                    "enum": [
                      "volatile",
                      "transient_local"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "duration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,9}|[1-5][0-9]{10}|60000000000)(?![\\s\\S])"
            },
            "unit": {
              "const": "ns"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,6}|[1-5][0-9]{7}|60000000)(?![\\s\\S])"
            },
            "unit": {
              "const": "us"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|60000)(?![\\s\\S])"
            },
            "unit": {
              "const": "ms"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9]|[1-5][0-9]|60)(?![\\s\\S])"
            },
            "unit": {
              "const": "s"
            }
          }
        }
      ]
    }
  },
  "$comment": "Decoded duplicate JSON keys, duplicate stream keys, aggregate ingress budgets and public ROS topic/type validation are additionally checked by C++ ingress."
}
