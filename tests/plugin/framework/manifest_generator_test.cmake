if(NOT DEFINED RODAQ_SOURCE_DIR)
    message(FATAL_ERROR "RODAQ_SOURCE_DIR is required")
endif()

set(test_dir "${CMAKE_CURRENT_BINARY_DIR}/manifest-generator-test")
file(MAKE_DIRECTORY "${test_dir}")
set(artifact "${test_dir}/plugin.so")
file(WRITE "${artifact}" "artifact")

set(RODAQ_MANIFEST_OUTPUT "${test_dir}/manifest.json")
set(RODAQ_ARTIFACT_PATH "${artifact}")
set(RODAQ_PLUGIN_ID "com.rodaq.test.manifest-generator")
set(RODAQ_PLUGIN_NAME "Manifest\tGenerator")
set(RODAQ_PLUGIN_VERSION "1.0.0")
set(RODAQ_PLUGIN_ARCH "amd64")
include("${RODAQ_SOURCE_DIR}/cmake/GeneratePluginManifest.cmake")

file(READ "${RODAQ_MANIFEST_OUTPUT}" manifest)
if(NOT manifest MATCHES "Manifest\\\\tGenerator")
    message(FATAL_ERROR "Manifest generator did not escape tab")
endif()
if(manifest MATCHES "[^\\\\]\t")
    message(FATAL_ERROR "Manifest generator emitted a raw tab")
endif()
