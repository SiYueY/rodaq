option(RODAQ_ENABLE_CLANG_TIDY "Run clang-tidy 14 on project translation units" OFF)
set(RODAQ_SANITIZER "none" CACHE STRING "Sanitizer: none, address-undefined, thread")
set_property(CACHE RODAQ_SANITIZER PROPERTY STRINGS none address-undefined thread)

if(NOT RODAQ_SANITIZER STREQUAL "none")
    if(RODAQ_SANITIZER STREQUAL "address-undefined")
        set(rodaq_sanitize_flags -fsanitize=address,undefined -fno-omit-frame-pointer)
    elseif(RODAQ_SANITIZER STREQUAL "thread")
        set(rodaq_sanitize_flags -fsanitize=thread -fno-omit-frame-pointer)
    else()
        message(FATAL_ERROR "Unknown RODAQ_SANITIZER: ${RODAQ_SANITIZER}")
    endif()
    add_compile_options(${rodaq_sanitize_flags})
    add_link_options(${rodaq_sanitize_flags})
endif()

if(RODAQ_ENABLE_CLANG_TIDY)
    find_program(RODAQ_CLANG_TIDY NAMES clang-tidy-14 REQUIRED)
    execute_process(COMMAND ${RODAQ_CLANG_TIDY} --version OUTPUT_VARIABLE tidy_version)
    if(NOT tidy_version MATCHES "version 14\\.")
        message(FATAL_ERROR "RoDAQ requires clang-tidy 14.x")
    endif()
endif()
