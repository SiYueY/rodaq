{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rodaq:task-config:1.0",
  "$comment": "Executable projection of frozen Notion Task 2.1 Portable TaskConfig. Task owner additionally validates UTF-8 byte/deployment bounds, Task-scoped identities, installed exact Plugin versions/roles and private semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "segment_policy",
    "retention_policy",
    "pipelines"
  ],
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-rodaq-max-utf8-bytes": 128
    },
    "segment_policy": {
      "$ref": "#/$defs/segment"
    },
    "retention_policy": {
      "$ref": "#/$defs/retention"
    },
    "pipelines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pipeline"
      },
      "x-rodaq-cardinality-limit": "max_pipelines"
    }
  },
  "$defs": {
    "positive_safe_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "positive_uint64_string": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$",
      "maxLength": 20
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_duration_ms",
        "max_physical_bytes"
      ],
      "properties": {
        "max_duration_ms": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/positive_safe_integer" }
          ]
        },
        "max_physical_bytes": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/positive_safe_integer" }
          ]
        }
      },
      "anyOf": [
        { "properties": { "max_duration_ms": { "not": { "type": "null" } } } },
        { "properties": { "max_physical_bytes": { "not": { "type": "null" } } } }
      ]
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "max_duration_ms",
        "max_physical_bytes"
      ],
      "properties": {
        "mode": {
          "enum": ["keep_all", "rolling"]
        },
        "max_duration_ms": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/positive_safe_integer" }
          ]
        },
        "max_physical_bytes": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/positive_safe_integer" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "keep_all" } } },
          "then": {
            "properties": {
              "max_duration_ms": { "type": "null" },
              "max_physical_bytes": { "type": "null" }
            }
          },
          "else": {
            "anyOf": [
              { "properties": { "max_duration_ms": { "not": { "type": "null" } } } },
              { "properties": { "max_physical_bytes": { "not": { "type": "null" } } } }
            ]
          }
        }
      ]
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_id",
        "plugin_version",
        "config"
      ],
      "properties": {
        "plugin_id": {
          "type": "string",
          "pattern": "^[a-z0-9._-]{1,255}$"
        },
        "plugin_version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "config": {
          "type": "object"
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_key",
        "readiness_policy"
      ],
      "properties": {
        "stream_id": {
          "$ref": "#/$defs/positive_uint64_string"
        },
        "stream_key": {
          "type": "string",
          "pattern": "^[!-~]{1,128}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-rodaq-max-utf8-bytes": 128
        },
        "readiness_policy": {
          "enum": ["entry_ready", "source_ready"]
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "resource_profile",
        "output_root",
        "acquisition",
        "storage",
        "streams"
      ],
      "properties": {
        "pipeline_id": {
          "$ref": "#/$defs/positive_uint64_string"
        },
        "required": {
          "type": "boolean"
        },
        "resource_profile": {
          "type": "string",
          "pattern": "^[!-~]{1,128}$"
        },
        "output_root": {
          "type": "string",
          "pattern": "^[!-~]{1,128}$"
        },
        "acquisition": {
          "$ref": "#/$defs/plugin"
        },
        "storage": {
          "$ref": "#/$defs/plugin"
        },
        "streams": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stream"
          },
          "x-rodaq-cardinality-limit": "max_streams_per_pipeline"
        }
      }
    }
  }
}
